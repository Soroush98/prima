# Copy this file to `.env` and add your key. REQUIRED — Prima's agents call a
# live Claude model on every request (there is no offline path).
ANTHROPIC_API_KEY=

# Which Claude model the agent fleet uses.
PRIMA_MODEL=claude-sonnet-4-6

# Rate / quota controls (optional; defaults shown).
# PRIMA_LLM_CONCURRENCY — max simultaneous Claude calls across all requests.
# PRIMA_RATE_BURST / PRIMA_RATE_PER_MIN — per-caller /api/analyze quota.
PRIMA_LLM_CONCURRENCY=4
PRIMA_RATE_BURST=5
PRIMA_RATE_PER_MIN=20
