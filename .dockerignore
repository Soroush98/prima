# deps & build output (reinstalled / regenerated in the image)
node_modules
.next
tsconfig.tsbuildinfo

# secrets — provided at runtime via `fly secrets set`
.env
.env.*
!.env.example

# data artifacts. The committed, derived data/prima.db (the read-only SMD warehouse)
# IS shipped — the runner copies it. Everything else here is excluded.
data/*.db-*
data/*.db.building
data/online-retail.csv
data/eval-*.db
# 360MB raw AIOps dataset — only the small data/aiops-sample.json ships in the image
data/aiops-kpi/
# 464MB raw SMD — the image uses the committed prima.db, so the raw files never
# enter the build context (they're only needed locally for bench_smd.py).
data/smd/

# python service (deployed as its own Fly app from ml-service/)
ml-service/.venv
ml-service/__pycache__
**/__pycache__

# misc
.git
.gitignore
npm-debug.log*
*.log
